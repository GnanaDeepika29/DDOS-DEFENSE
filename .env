# =============================================================================
# DDoS Detection & Mitigation System — Production Environment
# =============================================================================
# This file is loaded by config/settings.py via python-dotenv.
# Keep secrets out of version control — .gitignore should exclude this file.
# =============================================================================

# ── Dataset ──────────────────────────────────────────────────────────────────
DATASET_DIR=/app/data/dataset

# ── Detection Engine ─────────────────────────────────────────────────────────
DETECTION_THRESHOLD=0.7
CONFIDENCE_THRESHOLD=0.8
ACTIVE_MODEL=random_forest

# ── Packet Capture ───────────────────────────────────────────────────────────
CAPTURE_INTERFACE=\Device\NPF_Loopback
CAPTURE_FILTER=ip
CAPTURE_TIMEOUT=10
FLOW_TIMEOUT=120.0
FLOW_ACTIVITY_TIMEOUT=30.0
FEATURE_WINDOW_SIZE=50

# ── Mitigation ───────────────────────────────────────────────────────────────
AUTO_BLOCK_ENABLED=False
BLOCK_DURATION=3600
RATE_LIMIT_THRESHOLD=1000
MAX_CONNECTIONS_PER_IP=100

# ── Alerting ─────────────────────────────────────────────────────────────────
EMAIL_ENABLED=True
WEBHOOK_ENABLED=False
WEBHOOK_URL=
WEBHOOK_SECRET=

# ── Email (SMTP) ─────────────────────────────────────────────────────────────
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=gnanadeepika2982004@gmail.com
EMAIL_PASSWORD=bhrekqedlgpivpcy
EMAIL_RECIPIENTS=gnanadeepika2982004@gmail.com
EMAIL_FROM=gnanadeepika2982004@gmail.com
EMAIL_USE_TLS=True

# ── API Server ───────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ALLOW_ORIGINS=*

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/ddos.db

# ── Logging ────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

EXTRA_WHITELIST=
FLOW_TIMEOUT=120
FLOW_ACTIVITY_TIMEOUT=5
ENTROPY_THRESHOLD=0.6
WORKER_THREADS=4
PACKET_QUEUE_SIZE=10000
INFERENCE_BATCH_SIZE=256
